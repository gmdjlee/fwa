<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 3 에서 플로팅 버블에 필요. Phase 0 에서는 미사용 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- P3-1 BootReceiver: 콜드 부팅 후 버블 자동 복귀 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ 패키지 가시성: 대상 앱 라벨 조회(PackageManager.getApplicationLabel)에 필요.
         라벨은 SplitEntry 의 Recents 카드 셀렉터 정밀도를 높인다 (라벨 없으면 "고급 옵션" 단독 매칭 → 다중 카드 오탐 위험). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_bubble"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoldWindow">

        <activity
            android:name=".probe.ProbeActivity"
            android:exported="true"
            android:label="@string/probe_title"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".probe.ProbeAccessibilityService"
            android:exported="true"
            android:label="@string/probe_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/probe_accessibility_config" />
        </service>

        <!-- Phase 0 진단 전용: adb 브로드캐스트로 프로브 트리거.
             android:exported="true" 는 adb `am broadcast` 로 외부 트리거하기 위함이다.
             디버그 진단 도구이므로 허용한다. Phase 0 이후 제거 예정. -->
        <receiver
            android:name=".probe.ProbeTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.dj.foldwindow.probe.RUN_PROBE" />
            </intent-filter>
        </receiver>

        <!-- P2-5 / ADR-3: 파트너(비영상) 창. MAIN/LAUNCHER 필터가 필요한 이유: One UI 분할 화면
             파트너 피커(SplitEntry step4 폴백, "FromRecentActivity")가 런처에 노출된 앱만 후보로
             나열한다. 앱 서랍에 아이콘이 노출되는 부작용은 Phase 2에서는 수용하고, Phase 3에서
             별도 태스크/숨김 아이콘 처리로 재검토한다. -->
        <!-- launchMode 미지정(standard): singleTask 는 이전 전체화면 태스크를 재사용해
             분할 배치를 파괴함 ([측정] 2026-07-25). -->
        <activity
            android:name=".ui.PanelActivity"
            android:exported="true"
            android:label="@string/panel_title"
            android:resizeableActivity="true"
            android:taskAffinity="dev.dj.foldwindow.panel"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- P2-1 실제 액추에이터 서비스. 상태 머신 구동, 분할 진입/드래그/재측정 오케스트레이션. -->
        <service
            android:name=".service.ArrangerAccessibilityService"
            android:exported="true"
            android:label="@string/arranger_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/arranger_accessibility_config" />
        </service>

        <!-- Phase 2 디버그 트리거. Phase 3에서 플로팅 버블(FloatingLauncherService)이 대체한다.
             android:exported="true" 는 adb `am broadcast` 로 외부 트리거하기 위함이다
             (probe.ProbeTriggerReceiver 와 동일 근거). -->
        <receiver
            android:name=".service.ArrangeTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.dj.foldwindow.ARRANGE" />
            </intent-filter>
        </receiver>

        <!-- P3-1: 사용자용 플로팅 버블 런처. 원터치로 ArrangerAccessibilityService.startArrange 를 호출한다.
             foregroundServiceType="specialUse" — Android 14+ (API 34) 타겟 요건. PROPERTY_SPECIAL_USE_FGS_SUBTYPE
             로 용도를 명시한다 (오버레이 버블 원터치 배치 트리거). -->
        <service
            android:name=".service.FloatingLauncherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="overlay_bubble_arrange_launcher" />
        </service>

        <!-- P3-1 보조: 콜드 부팅 후 버블 자동 복귀. bubble_enabled prefs + 오버레이 권한 확인 후에만 시작한다
             (BootReceiver.onReceive). exported="true" 는 시스템이 보내는 BOOT_COMPLETED 브로드캐스트를
             받기 위한 표준 요건이다 — 이 액션은 보호된 브로드캐스트라 제3자 앱이 스푸핑할 수 없다. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- P3-4: 앱의 실제 진입점(온보딩). 권한 유도 + 버블 시작/중지 + 사용 안내.
             probe.ProbeActivity 의 LAUNCHER 필터는 Phase 0 도구로 그대로 유지한다(추후 제거 예정). -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- P4-4: 홈 화면 고정 바로가기(pinned shortcut) 트램펄린. 런처가 쏘는 바로가기 인텐트
             수신용으로 exported="true" 가 필요하다(probe.ProbeTriggerReceiver 등 기존 exported
             항목과 동일 근거). noHistory/excludeFromRecents 로 백스택·최근 앱 목록에 흔적을 남기지
             않는다 — 대상 앱을 실행하고 배치를 트리거한 뒤 즉시 finish 되는 순수 트램펄린이다. -->
        <activity
            android:name=".ui.PairShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="dev.dj.foldwindow.pairshortcut"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- P4-1: Shizuku 클라이언트 등록. Shizuku 앱/서비스가 이 provider 존재로 우리 앱을
             인식하고 권한 요청·UserService 바인드를 중개한다. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
