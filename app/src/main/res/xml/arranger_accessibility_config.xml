<?xml version="1.0" encoding="utf-8"?>
<!--
  P2-1 액추에이터 서비스 설정. probe_accessibility_config.xml 과 동일한 capability 집합을 쓴다.

  flagRetrieveInteractiveWindows : 디바이더/앱 페인 창 목록 조회 (DividerLocator, PaneGeometry)
  canPerformGestures             : 디바이더 드래그(DividerDragger), 페인 전환 탭(PaneSwapper)
  canRetrieveWindowContent       : Recents/팝업 노드 탐색 (SplitEntry, PaneSwapper)
  canTakeScreenshot              : letterbox 사전측정 + 폐루프 보정 실측 (ADR-1 ②, ADR-5)
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/arranger_service_desc"
    android:notificationTimeout="100" />
