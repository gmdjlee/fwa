<?xml version="1.0" encoding="utf-8"?>
<!-- P5: "앱 페어 바로가기 만들기". 겹친 둥근 사각형 두 개 = 한 쌍을 복제해 내보낸다.

     [D8] 종전에는 앞쪽 채움 사각형이 뒤쪽 윤곽 사각형 위에 **그대로 얹혀** 두 도형의 선이
     맞붙었다 — 22dp 로 줄이면 둘이 한 덩어리로 융합돼 "겹친 두 개" 라는 의미가 사라졌다.

     [D8 구현 — 비평의 처방과 다른 점, 그리고 그 이유]
     비평은 "표면색 녹아웃 링" 을 제안했지만 이 아이콘에는 성립하지 않는다: 메뉴 아이콘은
     런타임에 ImageView.imageTintList(SRC_IN)로 통째로 틴트되므로, 벡터 안에 어떤 색을 적어
     넣어도 전부 같은 틴트 색으로 덮인다 — "배경색으로 칠한 링" 이라는 개념 자체가 없다.
     그래서 색이 아니라 **기하로** 판다: 뒤쪽 프레임의 우하단이 앞쪽 도형을 2.2 단위 바깥에서
     비껴가도록 윤곽선 자체에 노치를 냈다(뒤 프레임 경로의 V8.2 → H11.8 → A3.6 구간).
     스트로크가 사방 0.8 나가므로 실제 빈 틈은 2.2 − 0.8 = 1.4 단위 ≒ 비평이 요구한 링 두께다.
     노치의 두 직각 이음매는 strokeLineJoin="round" 로 둥글려 세트의 다른 아이콘(전부 둥근
     사각형·스타디움 계열)과 결을 맞춘다.

     [D6/F6] 잉크 범위 3.0 → 20.2(뒤 프레임 스트로크 바깥 ~ 앞 도형 끝)로 가족 광학 박스에 든다.
     path 데이터로 재검산한 값이다(종전 주석의 20.4 는 오기):
       · 좌/상단 = 뒤 프레임 윤곽 3.8 − strokeWidth 1.6 의 절반 0.8 = 3.0
       · 우/하단 = 앞 채움 직선 끝 18.8 + 코너 반경 1.4 = 20.2 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 뒤쪽 프레임(윤곽). 우하단에 앞쪽 도형을 피하는 노치가 있다. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M6,3.8 H12.4 A2.2,2.2 0 0 1 14.6,6 V8.2 H11.8 A3.6,3.6 0 0 0 8.2,11.8 V14.6 H6 A2.2,2.2 0 0 1 3.8,12.4 V6 A2.2,2.2 0 0 1 6,3.8 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="1.6" />
    <!-- 앞쪽 도형(채움). 반경 1.4 = 세트 공통 채움 곡률. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.8,10.4 H18.8 A1.4,1.4 0 0 1 20.2,11.8 V18.8 A1.4,1.4 0 0 1 18.8,20.2 H11.8 A1.4,1.4 0 0 1 10.4,18.8 V11.8 A1.4,1.4 0 0 1 11.8,10.4 Z" />
</vector>
