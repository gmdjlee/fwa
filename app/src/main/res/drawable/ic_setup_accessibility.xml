<?xml version="1.0" encoding="utf-8"?>
<!-- 온보딩 「접근성 서비스」 권한 아이콘. 둥근 머리 + 굵은 라운드 팔/다리 픽토그램.
     헤어라인 대신 두꺼운 round-cap 스트로크로 ic_bubble.xml 의 소프트 톤에 맞춘다.

     [D12] 광학 폭 15.2 → 16.2 (권한 글리프 4종을 16~17 로 통일). 팔 바를 좌우로 늘렸다. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 머리 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9.7,4.4 A2.3,2.3 0 1 1 14.3,4.4 A2.3,2.3 0 1 1 9.7,4.4 Z" />
    <!-- 팔 (라운드 바, 3.9..20.1) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.9,8.3 H20.1 A1.15,1.15 0 0 1 20.1,10.6 H3.9 A1.15,1.15 0 0 1 3.9,8.3 Z" />
    <!-- 몸통 + 다리 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.4"
        android:pathData="M12,10.6 V14.2 L9.4,19.8 M12,14.2 L14.6,19.8" />
</vector>
